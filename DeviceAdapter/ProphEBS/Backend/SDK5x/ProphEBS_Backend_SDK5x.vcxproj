  <!--
    Deliberately does NOT import MMCommon.props/MMDeviceAdapter.props (unlike
    ProphEBS.vcxproj): this project implements IProphEBSBackend only, links
    no MM/MMDevice headers at all, and must not pick up MM's
    "mmgr_dal_(ProjectName)" output-naming convention. OutDir/IntDir are set
    explicitly below instead, pointed at the same shared build output folder
    ProphEBS.vcxproj uses (via MMCommon.props' SolutionDir\build\...
    convention) so both DLLs land side by side, ready to be copied to a
    MicroManager install folder together. See docs/BUILD_AND_USAGE.md,
    "Adding a new Metavision SDK generation backend."
  -->
  <ImportGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ImportGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
