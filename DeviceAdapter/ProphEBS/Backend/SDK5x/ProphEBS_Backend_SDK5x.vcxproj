    <LinkIncremental Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">true</LinkIncremental>
    <LinkIncremental Condition="'$(Configuration)|$(Platform)'=='Release|x64'">false</LinkIncremental>
    <!-- Mirrors ProphEBS.vcxproj's own build-output convention
         ($(SolutionDir)build\$(Configuration)\$(Platform)\, from
         MMCommon.props) without needing to import that file; this project
         is always built either standalone or as part of ProphEBS.sln, whose
         SolutionDir is DeviceAdapter\ProphEBS\. -->
    <OutDir>$(SolutionDir)build\$(Configuration)\$(Platform)\</OutDir>
    <IntDir>$(SolutionDir)build\intermediates\$(Configuration)\$(Platform)\$(ProjectName)\</IntDir>
    <TargetName>ProphEBS_Backend_SDK5x</TargetName>
  </PropertyGroup>
