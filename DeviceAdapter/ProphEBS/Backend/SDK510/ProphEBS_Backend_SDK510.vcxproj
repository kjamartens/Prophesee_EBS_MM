  <!--
    Deliberately does NOT import MMCommon.props/MMDeviceAdapter.props (unlike
    ProphEBS.vcxproj): this project implements IProphEBSBackend only, links
    no MM/MMDevice headers at all, and must not pick up MM's
    "mmgr_dal_(ProjectName)" output-naming convention. OutDir/IntDir are set
    explicitly below instead, pointed at the same shared build output folder
    ProphEBS.vcxproj uses (via MMCommon.props' SolutionDir\build\...
    convention) so both DLLs land side by side, ready to be copied to a
    MicroManager install folder together. See docs/BUILD_AND_USAGE.md,
    "Adding a new Metavision SDK generation backend."
  -->
  <ImportGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ImportGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <_ProjectFileVersion>10.0.40219.1</_ProjectFileVersion>
    <LinkIncremental Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">true</LinkIncremental>
    <LinkIncremental Condition="'$(Configuration)|$(Platform)'=='Release|x64'">false</LinkIncremental>
    <!-- Mirrors ProphEBS.vcxproj's own build-output convention
         ($(SolutionDir)build\$(Configuration)\$(Platform)\, from
         MMCommon.props) without needing to import that file; this project
         is always built either standalone or as part of ProphEBS.sln, whose
         SolutionDir is DeviceAdapter\ProphEBS\. -->
    <OutDir>$(SolutionDir)build\$(Configuration)\$(Platform)\</OutDir>
    <IntDir>$(SolutionDir)build\intermediates\$(Configuration)\$(Platform)\$(ProjectName)\</IntDir>
    <TargetName>ProphEBS_Backend_SDK510</TargetName>
  </PropertyGroup>
  <!--
    Defaults to this repo's own vendored copy of Metavision SDK 5.1.1 under
    SDKs\510\ (see docs/BUILD_AND_USAGE.md, "Adding a new Metavision SDK
    generation backend"): one version-pinned install per backend, not
    whatever happens to be installed system-wide, so a rebuild is
    reproducible regardless of what's on this machine's PATH. Pass
    /p:MetavisionSdkRoot=... to MSBuild to point at a different install
    (e.g. a fresh system install of the same generation) if needed.
  -->
  <PropertyGroup>
    <MetavisionSdkRoot Condition="'$(MetavisionSdkRoot)'==''">$(SolutionDir)..\..\SDKs\510</MetavisionSdkRoot>
  </PropertyGroup>
