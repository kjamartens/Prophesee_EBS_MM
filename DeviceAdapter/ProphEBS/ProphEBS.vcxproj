  <!--
    Backend-shim refactor: this project no longer links the Prophesee
    Metavision SDK at all; every Metavision::-facing call now lives in a
    separate per-SDK-generation backend DLL (Backend/SDK5x/, etc.), loaded
    dynamically at runtime by BackendLoader.cpp. See
    Backend/IProphEBSBackend.h and docs/BUILD_AND_USAGE.md, "Adding a new
    Metavision SDK generation backend."

    This project does, however, still need Boost headers on its own account:
    the Goal 4 MDA-save-path auto-discovery code (TryDiscoverMdaRootPrefix()
    in ProphEBS.cpp) uses boost::property_tree to parse MicroManager's own
    JSON files, which has nothing to do with Metavision. Before this refactor
    that include path came along for free as a side effect of
    $(MetavisionSdkRoot)\third_party\include (the Metavision SDK installer
    happens to bundle Boost for its own OpenCV/HDF5 dependencies); now that
    this project no longer references MetavisionSdkRoot at all, BoostRoot is
    its own explicit override point, defaulting to that same bundled copy
    since it's already known to work and be present wherever the Metavision
    SDK is installed on a build machine. Header-only usage (property_tree),
    so no library to link.
  -->
  <PropertyGroup>
    <BoostRoot Condition="'$(BoostRoot)'==''">C:\Program Files\Prophesee\third_party\include</BoostRoot>
  </PropertyGroup>
